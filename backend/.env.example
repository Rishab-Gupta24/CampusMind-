# Supabase (backend only — never in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sources

# Models
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=24h
EMBED_MODEL=bge-m3
EMBED_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
WHISPER_MODEL=small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Retrieval
TOP_K_RETRIEVE=40
TOP_K_FINAL=5
MIN_RELEVANCE=0.02
BOOST_OFFICIAL=0.04
BOOST_SENIOR=0.04
BOOST_FLAGGED=0.05
BOOST_SECTION=0.03

# OCR (scanned pages, handwritten notes); empty OCR_MODEL = LLM_MODEL
OCR_ENABLED=true
OCR_MODEL=
OCR_DPI=150
OCR_MAX_PAGES=80

# Uploads
MAX_UPLOAD_MB=200
PDF_COMPRESS_OVER_MB=20
MAX_STORED_MB=50
AUDIO_BITRATE=24k

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000
